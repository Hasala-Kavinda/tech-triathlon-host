NODE_ENV=development
PORT=3000
HOST=0.0.0.0
MONGODB_URI=mongodb://localhost:27017/waylink
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=8h
LOGIN_ORIGIN=http://localhost:5173
DISPATCHER_ORIGIN=http://localhost:5174
LOADER_ORIGIN=http://localhost:5175
DRIVER_ORIGIN=http://localhost:5176
STORE_MANAGER_ORIGIN=http://localhost:5177
REFERENCE_DATA_DIR=../Drive Data
# Path is resolved from the backend package during direct local execution.
CSC_PRODUCTS_FILE=../CSC/products.demo.csv
ALLOW_DEMO_PRODUCTS=false
SEED_DEMO_SCENARIO=false
LOG_LEVEL=info
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Development phase switch (see the root .env.example). Keep false unless you are testing locally.
DEV_MODE=false
