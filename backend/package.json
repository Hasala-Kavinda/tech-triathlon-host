{
  "name": "waylink-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scenario": "tsx src/dev/scenario-cli.ts",
    "seed": "tsx src/database/seed/index.ts",
    "seed:preflight": "tsx src/database/seed/preflight-cli.ts ../CSC/products.demo.csv",
    "seed:reference": "tsx src/database/seed/index.ts reference",
    "seed:users": "tsx src/database/seed/index.ts users",
    "seed:demo": "tsx src/database/seed/index.ts demo",
    "db:migrate": "tsx src/db/migrations/cli.ts",
    "db:migrate:test": "vitest run runner.test"
  },
  "dependencies": {
    "@fastify/cors": "11.1.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/swagger": "9.5.2",
    "argon2": "0.44.0",
    "cloudinary": "2.11.0",
    "csv-parse": "6.1.0",
    "dotenv": "17.2.3",
    "fastify": "5.6.1",
    "jose": "6.1.0",
    "luxon": "3.7.2",
    "mongoose": "8.19.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/luxon": "3.7.1",
    "@types/node": "24.7.2",
    "pino-pretty": "13.1.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
