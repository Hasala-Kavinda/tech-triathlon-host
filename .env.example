JWT_SECRET=replace-with-at-least-32-random-characters
# Docker Compose path to the approved product fixture mounted under /csc.
CSC_PRODUCTS_FILE=/csc/products.demo.csv
# Explicit demo-only escape hatch. Never enable silently in production.
ALLOW_DEMO_PRODUCTS=false
SEED_DEMO_SCENARIO=true
# Required for photo uploads (Driver meter photos, receipt evidence). Get the three values from the Cloudinary
# dashboard (Settings -> API Keys). The API refuses to start while they are empty or placeholders.
CLOUDINARY_CLOUD_NAME=your-cloud-name-here
CLOUDINARY_API_KEY=your-api-key-here
CLOUDINARY_API_SECRET=your-api-secret-here
# Development phase switch. true = relaxed order-date and Fresh-deadline rules so the scheduling flow can
# be tested at any time. false (or unset) = real production rules. The API refuses true when NODE_ENV=production.
DEV_MODE=true
