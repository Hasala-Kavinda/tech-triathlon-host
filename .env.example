JWT_SECRET=replace-with-at-least-32-random-characters
# Docker Compose path to the approved product fixture mounted under /csc.
CSC_PRODUCTS_FILE=/csc/products.demo.csv
# Explicit demo-only escape hatch. Never enable silently in production.
ALLOW_DEMO_PRODUCTS=false
# Deterministic date used only by demo frontend builds.
VITE_SERVICE_DATE=2026-10-01
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
